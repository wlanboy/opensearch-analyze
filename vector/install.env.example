# Kopieren nach vector/install.env und anpassen. Wird von download.sh, install.sh,
# users.sh und index.sh gelesen.
# Alle Werte sind optional, gezeigt sind die Defaults.

# --- Quell-Dateien ---
# Verzeichnis mit opensearch-min-<V>-linux-<arch>.tar.gz und opensearch-knn-<V>.0.zip
# (wird bis eine Ebene tief durchsucht, also auch ~/Downloads)
ARTIFACT_DIR=$HOME
# Leer = höchste gefundene Version; sonst z.B. 3.9.0
OPENSEARCH_VERSION=3.9.0
# Erwartete SHA-512 des k-NN-Zips (ci.opensearch.org liefert keine .sha512-Datei):
# KNN_SHA512=
# Erwartete SHA-512 des Security-Zips (nur mit users.sh; alternativ .sha512 daneben legen):
# SECURITY_SHA512=
# Plugin neural-search für die hybride Suche (BM25 + k-NN):
# auto = installieren, falls opensearch-neural-search-<V>.0.zip da ist; true = Pflicht; false = entfernen
NEURAL_SEARCH=auto
# NEURAL_SHA512=
# Plugins job-scheduler + index-management (ISM, Index-Verwaltung in Dashboards):
# auto = installieren, falls beide Zips da sind (download.sh lädt sie); true = Pflicht; false = entfernen
INDEX_MANAGEMENT=auto
# JOB_SCHEDULER_SHA512=
# INDEX_MANAGEMENT_SHA512=
# INDEX_MANAGEMENT_DASHBOARDS_SHA512=

# --- Download (download.sh, lädt nach ARTIFACT_DIR) ---
# Ohne OPENSEARCH_VERSION lädt download.sh 3.9.0.
# Leer = Architektur dieses Rechners; x64 oder arm64 für einen anderen Server.
# Bei abweichender Architektur ignoriert download.sh die *_SHA512 oben.
# DOWNLOAD_ARCH=
# Security-Plugin laden: auto = nur, wenn users.sh Auth eingeschaltet hat; true; false
DOWNLOAD_SECURITY=true
# Build-ID der CI-Zips auf ci.opensearch.org; leer = aus dem Manifest des Builds
# BUILD_ID=
# OpenSearch Dashboards mitladen (für dashboards.sh): true; false
DOWNLOAD_DASHBOARDS=true
# Build-ID des Dashboards-Builds (für securityDashboards); leer = aus dem Manifest
# DASHBOARDS_BUILD_ID=
# Erwartete SHA-512 von securityDashboards-<V>.zip (ci.opensearch.org liefert keine .sha512):
# SECURITY_DASHBOARDS_SHA512=

# --- Zielverzeichnis ---
# BASE_DIR=/opt/local/opensearch

# --- Snapshots (bin/snapshot.sh) ---
# Mehrknoten-Cluster: muss ein gemeinsames Dateisystem (NFS) unter gleichem Pfad sein
# SNAPSHOT_DIR=$BASE_DIR/snapshots
# SNAPSHOT_KEEP=14

# --- Node / Cluster ---
# CLUSTER_NAME=opensearch-vector
# NODE_NAME=<hostname -s>       # nur CN im Zertifikat, kein SAN: als TLS-Hostname nur gültig, wenn = hostname -s
# NETWORK_HOST=127.0.0.1        # 0.0.0.0 oder IP für Zugriff von außen (vorher users.sh für Auth!)
#                               # landet als SAN im Node-Zertifikat (außer 0.0.0.0/localhost);
#                               # bei 0.0.0.0 externe IP/DNS in EXTRA_SANS eintragen, sonst
#                               # scheitern TLS-Clients (z.B. Dashboards-Datasource) an der Hostname-Prüfung
# HTTP_PORT=9200
# TRANSPORT_PORT=9300
# HEAP_SIZE=auto                # auto = 50% RAM, max. 31g; sonst z.B. 8g
# MEMORY_LOCK=false             # true braucht ulimit -l unlimited (root, siehe README)

# Mehrknoten-Cluster (leer = single-node):
# SEED_HOSTS=os-vec-1.example.com,os-vec-2.example.com,os-vec-3.example.com
# INITIAL_CLUSTER_MANAGER_NODES=os-vec-1,os-vec-2,os-vec-3

# --- Auth/TLS (users.sh) ---
# Passwörter nicht hier eintragen: users.sh erzeugt sie und speichert sie in
# BASE_DIR/config/users.env. Feste Passwörter per Umgebungsvariable
# ADMIN_PASSWORD / AGENT_PASSWORD / SEARCH_PASSWORD.
# ADMIN_USER=admin
# AGENT_USER=agent
# AGENT_ROLE=vector_agent
# AGENT_INDEX_PATTERNS=*        # Komma-getrennt, z.B. vectors-*,rag-*
# SEARCH_USER=search            # nur lesen/suchen, für Agents
# SEARCH_ROLE=vector_search
# SEARCH_INDEX_PATTERNS=<AGENT_INDEX_PATTERNS>   # z.B. manuals*
# EXTRA_SANS=                   # weitere Hostnamen/IPs fürs Node-Zertifikat (z.B. Load-Balancer)
# CERT_DAYS=3650

# --- Handbuch-Index (index.sh) ---
# Pflicht für index.sh: Dimension des Embedding-Modells, z.B. 1024 (bge-m3,
# multilingual-e5-large), 768 (multilingual-e5-base), 1536 (text-embedding-3-small)
# EMBEDDING_DIM=
# EMBEDDING_SPACE=cosinesimil   # cosinesimil, innerproduct oder l2 — passend zum Modell
# INDEX_PREFIX=manuals          # Template für manuals-*, Alias manuals, Pipeline manuals-hybrid
# TEXT_ANALYZER=german          # eingebauter Sprach-Analyzer, z.B. english
# INDEX_SHARDS=1
# INDEX_REPLICAS=               # leer = 0 bei single-node, sonst 1
# RRF_RANK_CONSTANT=60
