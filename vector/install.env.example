# Kopieren nach vector/install.env und anpassen. Wird von install.sh gelesen.
# Alle Werte sind optional, gezeigt sind die Defaults.

# --- Versionen ---
OPENSEARCH_VERSION=2.19.5
# KNN_VERSION=2.19.5.0

# --- Nexus ---
NEXUS_URL=https://nexus.example.com
# NEXUS_USER=deploy
# NEXUS_PASSWORD=...            # oder Zugangsdaten in /root/.netrc ablegen
# NEXUS_RAW_ARTIFACTS_REPO=opensearch-artifacts   # raw proxy -> https://artifacts.opensearch.org/
# NEXUS_RAW_CI_REPO=opensearch-ci                 # raw proxy -> https://ci.opensearch.org/
# NEXUS_MAVEN_REPO=maven-public                   # maven proxy -> https://repo1.maven.org/maven2/

# ci    = k-NN mit nativen Libraries (faiss, nmslib, lucene)   <- Default
# maven = k-NN ohne native Libraries (nur engine=lucene)
# KNN_SOURCE=ci
# Build-ID auf ci.opensearch.org pinnen statt "latest" (2.19.5 = 11769):
# KNN_CI_BUILD=latest
# Erwartete SHA-512 des k-NN-Zips (install.sh gibt sie beim ersten Download aus):
# KNN_SHA512=

# Komplette URLs, falls die Nexus-Pfade anders aussehen:
# OPENSEARCH_URL=https://nexus.example.com/repository/foo/opensearch-min-2.19.5-linux-x64.tar.gz
# OPENSEARCH_SHA512_URL=${OPENSEARCH_URL}.sha512
# KNN_URL=https://nexus.example.com/repository/bar/opensearch-knn-2.19.5.0.zip
# KNN_SHA512_URL=

# --- Pfade ---
# INSTALL_ROOT=/opt/opensearch
# CONF_DIR=/etc/opensearch
# DATA_DIR=/var/lib/opensearch
# LOG_DIR=/var/log/opensearch
# CACHE_DIR=/var/cache/opensearch-install
# OS_USER=opensearch
# SERVICE_NAME=opensearch

# --- Node / Cluster ---
# CLUSTER_NAME=opensearch-vector
# NODE_NAME=<hostname -s>
# NETWORK_HOST=127.0.0.1        # 0.0.0.0 oder IP für Zugriff von außen (ohne Auth!)
# HTTP_PORT=9200
# TRANSPORT_PORT=9300
# HEAP_SIZE=auto                # auto = 50% RAM, max. 31g; sonst z.B. 8g
# MEMORY_LOCK=true
# OPEN_FIREWALL=false           # true = HTTP_PORT/TRANSPORT_PORT in firewalld öffnen

# Mehrknoten-Cluster (leer = single-node):
# SEED_HOSTS=os-vec-1.example.com,os-vec-2.example.com,os-vec-3.example.com
# INITIAL_CLUSTER_MANAGER_NODES=os-vec-1,os-vec-2,os-vec-3
