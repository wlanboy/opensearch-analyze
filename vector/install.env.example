# Kopieren nach vector/install.env und anpassen. Wird von install.sh gelesen.
# Alle Werte sind optional, gezeigt sind die Defaults.

# --- Quell-Dateien ---
# Verzeichnis mit opensearch-min-<V>-linux-<arch>.tar.gz und opensearch-knn-<V>.0.zip
# (wird bis eine Ebene tief durchsucht, also auch ~/Downloads)
# ARTIFACT_DIR=$HOME
# Leer = höchste gefundene Version; sonst z.B. 2.19.5
# OPENSEARCH_VERSION=
# Erwartete SHA-512 des k-NN-Zips (ci.opensearch.org liefert keine .sha512-Datei):
# KNN_SHA512=
# Erwartete SHA-512 des Security-Zips (nur mit users.sh; alternativ .sha512 daneben legen):
# SECURITY_SHA512=

# --- Zielverzeichnis ---
# BASE_DIR=/opt/local/opensearch

# --- Node / Cluster ---
# CLUSTER_NAME=opensearch-vector
# NODE_NAME=<hostname -s>
# NETWORK_HOST=127.0.0.1        # 0.0.0.0 oder IP für Zugriff von außen (vorher users.sh für Auth!)
# HTTP_PORT=9200
# TRANSPORT_PORT=9300
# HEAP_SIZE=auto                # auto = 50% RAM, max. 31g; sonst z.B. 8g
# MEMORY_LOCK=false             # true braucht ulimit -l unlimited (root, siehe README)

# Mehrknoten-Cluster (leer = single-node):
# SEED_HOSTS=os-vec-1.example.com,os-vec-2.example.com,os-vec-3.example.com
# INITIAL_CLUSTER_MANAGER_NODES=os-vec-1,os-vec-2,os-vec-3

# --- Auth/TLS (users.sh) ---
# Passwörter nicht hier eintragen: users.sh erzeugt sie und speichert sie in
# BASE_DIR/config/users.env. Feste Passwörter per Umgebungsvariable
# ADMIN_PASSWORD / AGENT_PASSWORD.
# ADMIN_USER=admin
# AGENT_USER=agent
# AGENT_ROLE=vector_agent
# AGENT_INDEX_PATTERNS=*        # Komma-getrennt, z.B. vectors-*,rag-*
# EXTRA_SANS=                   # weitere Hostnamen/IPs fürs Node-Zertifikat (z.B. Load-Balancer)
# CERT_DAYS=3650
